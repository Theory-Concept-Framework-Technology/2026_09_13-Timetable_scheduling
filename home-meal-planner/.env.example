THEMEALDB_API_KEY=1
USDA_FDC_API_KEY=

# Docker Compose — run.bat / docker compose on PC or DigitalOcean
# This is the ONLY port published on the server (nginx: UI + /api/meals).
# Do NOT set WEB_PORT=8080 on the shared droplet (8080/8081/8090 are other apps).
WEB_PORT=8000

# Optional: only if you expose meal-api on the host for debugging (not required)
# MEAL_API_HOST_PORT=8001

# run_local.bat only (no Docker) — NOT used on DigitalOcean deploy
MEAL_API_PORT=8000
LOCAL_WEB_PORT=8080
