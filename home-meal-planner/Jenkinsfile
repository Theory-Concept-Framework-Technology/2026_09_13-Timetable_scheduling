pipeline {
    agent any

    stages {

        stage('Verify Meal Planner') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "HOME MEAL PLANNER"
                    echo "======================================"

                    cd home-meal-planner

                    echo "Current directory:"
                    pwd

                    echo "Backend:"
                    ls -la backend/app

                    echo "Frontend:"
                    ls -la frontend

                    echo "Deploy:"
                    ls -la deploy

                    echo "Checking Docker files..."

                    test -f deploy/Dockerfile.api
                    test -f deploy/Dockerfile.web
                    test -f docker-compose.yml

                    echo "Meal Planner files verified successfully."
                '''
            }
        }

        stage('Build API Docker Image') {
            steps {
                sh '''
                    set -e
                    cd home-meal-planner

                    echo "Building Meal API image..."

                    docker build \
                        -f deploy/Dockerfile.api \
                        -t home-meal-api:latest \
                        .

                    echo "API image built successfully."
                '''
            }
        }

        stage('Build Web Docker Image') {
            steps {
                sh '''
                    set -e
                    cd home-meal-planner

                    echo "Building Meal Web image..."

                    docker build \
                        -f deploy/Dockerfile.web \
                        -t home-meal-web:latest \
                        .

                    echo "Web image built successfully."
                '''
            }
        }

        stage('Docker Images') {
            steps {
                sh '''
                    echo "Docker images created:"
                    docker images | grep home-meal || true
                '''
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "MEAL PLANNER PIPELINE SUCCESS"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "MEAL PLANNER PIPELINE FAILED"
            echo "======================================"
        }
    }
}