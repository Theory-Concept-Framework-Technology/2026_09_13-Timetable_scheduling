# School Timetable — production coordinates (shared droplet with Zyrowaste)
# Copy to Deploy/.env for local deploy scripts, or to /opt/school-timetable/.env.production on the server.

PROD_HOST=143.244.128.22
DEPLOY_PATH=/opt/school-timetable
APP_PORT=8090
JENKINS_HTTP_PORT=8081
COMPOSE_PROJECT_NAME=school-timetable

DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=ghcr.io/<github-user>/school-timetable-fresh
IMAGE_TAG=latest

# Timetable app:     http://143.244.128.22:8090/
# Timetable Jenkins: http://143.244.128.22:8081/  (separate instance; 8080 = existing Jenkins)
# Zyrowaste:         https://zyrowaste.com (host 80/443)
#
# Second Jenkins on 8081 (example):
#   sudo mkdir -p /var/lib/jenkins-timetable
#   sudo chown jenkins:jenkins /var/lib/jenkins-timetable
#   sudo apt install jenkins  # if needed; or duplicate unit jenkins-new.service with:
#   Environment="JENKINS_HOME=/var/lib/jenkins-timetable"
#   Environment="HTTP_PORT=8081"
#   ExecStart=... jenkins.war --httpPort=8081
#   sudo systemctl enable --now jenkins-new
# Open TCP 8081 and 8090 in DigitalOcean firewall.
