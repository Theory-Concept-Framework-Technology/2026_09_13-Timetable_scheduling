# School Timetable — production coordinates (shared droplet with Zyrowaste)
# Copy to Deploy/.env for local deploy scripts, or to /opt/school-timetable/.env.production on the server.
# Do not commit real registry credentials or secrets.

PROD_HOST=143.244.128.22
DEPLOY_PATH=/opt/school-timetable
APP_PORT=444
JENKINS_HTTP_PORT=8090
COMPOSE_PROJECT_NAME=school-timetable

DOCKER_REGISTRY=ghcr.io
IMAGE_NAME=ghcr.io/<github-user>/school-timetable-fresh
IMAGE_TAG=latest

# Timetable app: http://143.244.128.22:444/
# Jenkins (this project): http://143.244.128.22:8090/
# On the droplet, set Jenkins HTTP port once: /etc/default/jenkins → HTTP_PORT=8090, then systemctl restart jenkins
# Zyrowaste keeps host ports 80/443 on the same droplet.
