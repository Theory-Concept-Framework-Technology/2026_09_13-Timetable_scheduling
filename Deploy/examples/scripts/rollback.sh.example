#!/bin/bash
# List recent image tags on the droplet; rollback = set IMAGE_TAG + re-run deploy.sh.

set +e

: "${PROD_HOST:?Set PROD_HOST}"
: "${DEPLOY_PATH:=/opt/school-timetable}"
: "${IMAGE_NAME:?Set IMAGE_NAME}"

COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-school-timetable}"

echo "========================================="
echo "Rollback helper"
echo "========================================="

ssh root@"${PROD_HOST}" bash <<EOF
set +e
cd '${DEPLOY_PATH}'

echo "Stopping project-scoped stack..."
docker compose -p '${COMPOSE_PROJECT_NAME}' -f docker-compose.yml down || true

echo "Recent tags for ${IMAGE_NAME}:"
docker images '${IMAGE_NAME}' --format '{{.Tag}}' | head -10

echo ""
echo "To rollback: export IMAGE_TAG=<previous-tag> and run Deploy/scripts/deploy.sh"
EOF

echo "Rollback procedure completed."
